# CityOS local environment — copy to .env

# PostgreSQL / PostGIS
POSTGRES_USER=cityos
POSTGRES_PASSWORD=cityos
POSTGRES_DB=cityos
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cityos:cityos@localhost:5432/cityos

# API
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
API_TITLE=CityOS API
ENVIRONMENT=development

# Frontend (also see frontend/.env.example)
NEXT_PUBLIC_API_URL=http://localhost:8000
